# XKAROYRESUME — Environment Variables Configuration
# Copy this file to .env.local before running `npm run dev`

# n8n AI Webhook Endpoint (Optional - falls back to built-in 12-Node AI Engine if omitted)
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat

# Supabase Connection (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
